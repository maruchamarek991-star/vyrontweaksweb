# Skopiuj do .env (lokalnie). Na Vercel dodaj te same nazwy w: Project -> Settings -> Environment Variables.
# Logowanie przez Discord wymaga tylko 3 wartosci:

# Discord Developer Portal -> Twoja aplikacja -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Ten sam adres wpisz w Discord Developer Portal -> OAuth2 -> Redirects -> Add Redirect (musi byc identyczny):
#   lokalnie: http://localhost:3000/api/auth/callback
#   Vercel:   https://twoja-domena.com/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- opcjonalnie: adresy portfeli pokazywane przy platnosci (domyslne sa w server.js) ---
LTC_ADDRESS=
SOL_ADDRESS=
ETH_ADDRESS=
